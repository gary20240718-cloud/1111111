-- ==========================================
-- 3. 全圖透視 + 固定射線 (不會亂飄)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not espEnabled then return end

    local activePlayers = {}
    local drawCount = 0

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            
            -- 🚨 放寬判定：只要活著，不管有沒有隱形都算
            if humanoid and humanoid.Health > 0 and head and root then
                activePlayers[player.UserId] = true

                if not char:FindFirstChild("HackHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "HackHighlight"
                    hl.Parent = char
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end

                local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
                local weapon = "空手"
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then weapon = tool.Name end

                local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    -- 限制一次最多畫 4 個人的線，防止畫面太亂
                    drawCount = drawCount + 1
                    if drawCount <= 4 then
                        local tagName = "ESP_Tag_" .. player.UserId
                        local textTag = ScreenGui:FindFirstChild(tagName)
                        if not textTag then
                            textTag = Instance.new("TextLabel")
                            textTag.Name = tagName
                            textTag.BackgroundTransparency = 1
                            textTag.TextColor3 = Color3.fromRGB(255, 255, 255)
                            textTag.TextSize = 12
                            textTag.TextStrokeTransparency = 0
                            textTag.Parent = ScreenGui
                        end
                        textTag.Visible = true
                        textTag.Text = "[" .. dist .. "m] " .. weapon
                        textTag.Position = UDim2.new(0, headPos.X - 40, 0, headPos.Y + 20)

                        local lineName = "ESP_Line_" .. player.UserId
                        local line = ScreenGui:FindFirstChild(lineName)
                        if not line then
                            line = Instance.new("Frame")
                            line.Name = lineName
                            line.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                            line.BorderSizePixel = 0
                            line.ZIndex = 1
                            line.Parent = ScreenGui
                        end
                        line.Visible = true
                        
                        -- 從最上方連到頭部
                        local screenSize = Camera.ViewportSize
                        local startPos = Vector2.new(screenSize.X / 2, 0) 
                        local endPos = Vector2.new(headPos.X, headPos.Y)
                        
                        local length = (startPos - endPos).Magnitude
                        local angle = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))
                        
                        line.Size = UDim2.new(0, length, 0, 1)
                        line.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
                        line.Rotation = angle - 90
                    end
                else
                    local textTag = ScreenGui:FindFirstChild("ESP_Tag_" .. player.UserId)
                    if textTag then textTag.Visible = false end
                    local line = ScreenGui:FindFirstChild("ESP_Line_" .. player.UserId)
                    if line then line.Visible = false end
                end
            end
        end
    end

    -- 清理
    for _, obj in pairs(ScreenGui:GetChildren()) do
        if obj.Name:match("ESP_Tag_") or obj.Name:match("ESP_Line_") then
            local idStr = obj.Name:gsub("ESP_Tag_", ""):gsub("ESP_Line_", "")
            local id = tonumber(idStr)
            if not activePlayers[id] then obj:Destroy() end
        end
    end
end)

-- ==========================================
-- 4. 絕對瞬鎖自瞄 (開火/點擊瞬間定位)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not aimEnabled then return end

    -- 尋找圈內最近敵人
    local closestHead = nil
    local shortestDistance = fovSize
    local screenCenter = Camera.ViewportSize / 2

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and screenPos.Z > 0 then
                    local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distToCenter < shortestDistance then
                        shortestDistance = distToCenter
                        closestHead = head
                    end
                end
            end
        end
    end

    -- 🔥 核心邏輯：如果敵人在圈內，而且你正在點擊螢幕 (開火/開鏡)
    if closestHead and isFiring then
        -- 直接將 CFrame 設為目標位置，實現「零延遲瞬間死鎖」
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, closestHead.Position)
    end
end)
