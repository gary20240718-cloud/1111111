-- 拉條控制
local function setupSlider(bg, fill, label, isFov)
    local dragging = false
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = UserInputService:GetMouseLocation()
            local relativeX = math.clamp(mousePos.X - bg.AbsolutePosition.X, 0, bg.AbsoluteSize.X)
            local percent = relativeX / bg.AbsoluteSize.X
            fill.Size = UDim2.new(percent, 0, 0, 10)
            
            if isFov then
                fovSize = math.floor(50 + (600 - 50) * percent)
                label.Text = "自瞄範圍: " .. fovSize
                FOVCircle.Size = UDim2.new(0, fovSize * 2, 0, fovSize * 2)
                FOVCircle.Position = UDim2.new(0.5, -fovSize, 0.5, -fovSize)
            else
                local val = math.floor(10 + (100 - 10) * percent)
                aimSpeed = val / 100
                label.Text = "自瞄力度: " .. val .. "%"
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

setupSlider(FOVSliderBG, FOVSliderFill, FOVLabel, true)
setupSlider(SpeedSliderBG, SpeedSliderFill, SpeedLabel, false)

